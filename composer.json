{
  "name": "mundoprogra/json-api",
  "description": "JSON:API 1.1 request validation and responses for Laravel 10 to 13.",
  "keywords": [
    "MundoProgra",
    "laravel",
    "json-api",
    "jsonapi"
  ],
  "homepage": "https://github.com/mundoprogra/json-api",
  "license": "MIT",
  "authors": [
    {
      "name": "Alvaro Romero",
      "email": "alvaro.romero@mundoprogra.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/mundoprogra/json-api/issues",
    "source": "https://github.com/mundoprogra/json-api"
  },
  "require": {
    "php": "^8.1",
    "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
    "illuminate/database": "^10.0||^11.0||^12.0||^13.0",
    "illuminate/http": "^10.0||^11.0||^12.0||^13.0",
    "illuminate/pagination": "^10.0||^11.0||^12.0||^13.0",
    "illuminate/routing": "^10.0||^11.0||^12.0||^13.0",
    "illuminate/support": "^10.0||^11.0||^12.0||^13.0",
    "illuminate/translation": "^10.0||^11.0||^12.0||^13.0",
    "illuminate/validation": "^10.0||^11.0||^12.0||^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^2.9||^3.0",
    "laravel/pint": "^1.14",
    "opis/json-schema": "^2.3",
    "orchestra/testbench": "^8.0||^9.0||^10.0||^11.0",
    "phpunit/phpunit": "^10.5||^11.0||^12.0"
  },
  "autoload": {
    "psr-4": {
      "MundoProgra\\JsonApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MundoProgra\\JsonApi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "MundoProgra\\JsonApi\\JsonApiServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
